// Prisma schema — Autores Independentes do Brasil
// Migra o "fake backend" localStorage (aib-data.js) para Postgres real.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Author {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String?
  googleId  String?  @unique
  generos   String[] @default(["Romance"])
  cidade    String?
  bio       String?
  fotoUrl   String?
  bannerUrl String?
  bannerPositionX Int @default(50)
  bannerPositionY Int @default(50)

  instagramUrl String?
  twitterUrl   String?
  siteUrl      String?

  enderecoCep         String?
  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?

  anoEntrada         Int
  plano              String  @default("Gratuito")
  planoCiclo         String?
  planoValorCentavos Int?
  status             String  @default("ativo")

  mpPreapprovalId      String?
  mpSubscriptionStatus String?

  avaliacaoMedia Float?
  avaliacoesQtd  Int     @default(0)
  seguidores     Int     @default(0)
  verificado     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books       Book[]
  eventos     AuthorEvent[]
  fotos       AuthorPhoto[]
  orders      Order[]
  conversas   Conversation[]
  avaliacoes  Review[]
  resetTokens PasswordResetToken[]
}

model Book {
  id            String  @id @default(cuid())
  authorId      String
  author        Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  titulo        String
  genero        String
  precoCentavos Int
  estoque       Int     @default(0)
  capaUrl       String?
  descricao     String?

  pesoGramas    Int?
  alturaCm      Int?
  larguraCm     Int?
  comprimentoCm Int?

  createdAt DateTime @default(now())
  orders    Order[]

  @@index([authorId])
}

model AuthorEvent {
  id        String  @id @default(cuid())
  authorId  String
  author    Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  nome      String
  diaInicio Int
  diaFim    Int?
  mes       String
  ano       Int
  local     String
  status    String  @default("Pendente")

  createdAt DateTime @default(now())

  @@index([authorId])
}

model AuthorPhoto {
  id        String @id @default(cuid())
  authorId  String
  author    Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  titulo    String
  categoria String
  url       String

  createdAt DateTime @default(now())

  @@index([authorId])
}

model Order {
  id                String  @id @default(cuid())
  authorId          String
  author            Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bookId            String?
  book              Book?   @relation(fields: [bookId], references: [id], onDelete: SetNull)
  livro             String
  comprador         String
  compradorEmail    String?
  compradorTelefone String?

  compradorCep         String?
  compradorRua         String?
  compradorNumero      String?
  compradorComplemento String?
  compradorBairro      String?
  compradorCidade      String?
  compradorUf          String?

  quantidade        Int     @default(1)
  valorCentavos     Int
  freteCentavos     Int?
  freteServico      String?
  status            String  @default("Aguardando pagamento")
  grupoPedidoId     String?

  createdAt DateTime @default(now())

  @@index([authorId])
  @@index([grupoPedidoId])
}

model Conversation {
  id       String @id @default(cuid())
  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  nome     String
  unread   Boolean @default(true)

  createdAt DateTime  @default(now())
  mensagens Message[]

  @@index([authorId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  de             String
  texto          String

  createdAt DateTime @default(now())

  @@index([conversationId])
}

model Review {
  id       String @id @default(cuid())
  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  nome     String
  texto    String
  estrelas Int    @default(5)

  createdAt DateTime @default(now())

  @@index([authorId])
}

model CollectiveEvent {
  id        String  @id @default(cuid())
  nome      String
  dia       Int
  mes       String
  categoria String
  local     String
  periodo   String?

  createdAt DateTime @default(now())
}

model MelhorEnvioToken {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  updatedAt DateTime @updatedAt
}

model CollectiveGalleryPhoto {
  id        String @id @default(cuid())
  titulo    String
  categoria String
  url       String

  createdAt DateTime @default(now())
}

model Article {
  id        String  @id @default(cuid())
  titulo    String
  resumo    String
  conteudo  String  @default("")
  categoria String
  autorNome String
  capaUrl   String?

  createdAt DateTime @default(now())
}

model Admin {
  id        String @id @default(cuid())
  email     String @unique
  senhaHash String

  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([])

  createdAt DateTime @default(now())
}

model RateLimitAttempt {
  id        String   @id @default(cuid())
  chave     String
  createdAt DateTime @default(now())

  @@index([chave, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  authorId  String
  author    Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([authorId])
}
