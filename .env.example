# Copie para .env.local (desenvolvimento) e configure os MESMOS NOMES nas variáveis de
# ambiente do projeto na Vercel (Production + Preview). NUNCA coloque valores reais neste
# arquivo nem o envie ao Git: ele só lista os nomes.
#
# Legenda:  [obrigatória] o site não sobe sem ela
#           [função]      só a funcionalidade indicada deixa de funcionar sem ela
#           [opcional]    tem valor padrão ou o recurso simplesmente é pulado
#
# Guia completo (onde obter cada chave, o que fazer se trocar): docs/operacao.md

# ---------------------------------------------------------------------------------------------
# Núcleo
# ---------------------------------------------------------------------------------------------

# [obrigatória] Postgres (Neon / Vercel Postgres / outro) — string de conexão completa.
DATABASE_URL=

# [obrigatória] Segredo que assina os cookies de sessão (JWT). Sem ela o servidor nem inicia.
# Gerar com: openssl rand -base64 32. Trocar o valor derruba todas as sessões abertas.
AUTH_SECRET=

# [função] URL pública do site, usada nos links dos e-mails (redefinir senha, acesso ao e-book,
# confirmação de recebimento) e nos retornos da Asaas. Em produção: https://autoresdobrasil.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------------
# Arquivos
# ---------------------------------------------------------------------------------------------

# [função] Vercel Blob PÚBLICO: capas, fotos de perfil, banners, galeria. Token do store público.
BLOB_READ_WRITE_TOKEN=

# [função] Vercel Blob PRIVADO (store "ebooks"): páginas dos e-books. É um store separado do
# público: não reutilize o token acima. Sem ela o envio e a leitura de e-books falham.
EBOOKS_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------------------------
# E-mail (Resend)
# ---------------------------------------------------------------------------------------------

# [função] Envio de e-mails (confirmação de compra, acesso ao e-book, recuperação de senha...).
RESEND_API_KEY=
# [opcional] Remetente. Padrão: "Autores Independentes do Brasil <contato@autoresdobrasil.com.br>"
EMAIL_FROM=
# [opcional] Endereço de contato mostrado nos e-mails e nos contratos. Padrão: contato@autoresdobrasil.com.br
EMAIL_CONTATO=

# ---------------------------------------------------------------------------------------------
# Pagamentos (Asaas) — compras de livros/e-books, assinaturas de plano e contrato da Bienal
# ---------------------------------------------------------------------------------------------

# [função] Chave de API da conta Asaas do coletivo (asaas.com → Integrações → API).
ASAAS_API_KEY=
# [função] Token que a Asaas envia no cabeçalho "asaas-access-token" dos webhooks. Nós o geramos
# e cadastramos igual no painel da Asaas (Integrações → Webhooks). Sem ele os webhooks são recusados.
ASAAS_WEBHOOK_TOKEN=
# [opcional] Padrão: https://api.asaas.com/v3 (produção). Para a sandbox: https://sandbox.asaas.com/api/v3
ASAAS_BASE_URL=

# ---------------------------------------------------------------------------------------------
# Tarefas automáticas (cron da Vercel)
# ---------------------------------------------------------------------------------------------

# [função] A Vercel envia "Authorization: Bearer <CRON_SECRET>" ao chamar /api/cron/*. Sem ela
# os repasses e as limpezas diárias não rodam. A mesma chave deve existir nas variáveis do projeto.
CRON_SECRET=

# ---------------------------------------------------------------------------------------------
# Proteção contra robôs (Cloudflare Turnstile) — formulários de cadastro
# ---------------------------------------------------------------------------------------------

# [opcional] Chave secreta. Se faltar, a verificação é PULADA (ninguém é bloqueado).
TURNSTILE_SECRET_KEY=
# [opcional] Chave pública do widget (aparece no navegador).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------------------------
# Login com Google (autores)
# ---------------------------------------------------------------------------------------------

# [função] Credenciais OAuth do Google. Sem elas o botão "Continuar com Google" não funciona.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# Mercado Pago (caminho legado: assinaturas antigas e vínculo de conta de autor)
# ---------------------------------------------------------------------------------------------

# [função] Access Token e chave do webhook da aplicação (developers.mercadopago.com.br).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# [função] Credenciais OAuth do marketplace (vínculo da conta Mercado Pago do autor).
MERCADOPAGO_MARKETPLACE_CLIENT_ID=
MERCADOPAGO_MARKETPLACE_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# Só para o seed (npx prisma db seed) — cria o primeiro administrador
# ---------------------------------------------------------------------------------------------

ADMIN_SEED_EMAIL=admin@autoresindependentes.com.br
ADMIN_SEED_PASSWORD=
